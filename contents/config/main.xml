<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="selectedTheme" type="Int">
            <label>Theme</label>
            <default>1</default>
        </entry>
        <entry name="ticker" type="String">
            <label>Single Stock Ticker</label>
            <default>AAPL</default>
        </entry>
        <entry name="isMultiMode" type="Bool">
            <label>Enable Multi-Stock List Mode</label>
            <default>false</default>
        </entry>
        <entry name="showTwoList" type="Bool">
            <label>Show Two List</label>
            <default>false</default>
        </entry>
        <entry name="twoColumnLeftWidth" type="Int">
            <label>Left column width in the two-column desktop view, in pixels (0 = automatic)</label>
            <default>0</default>
        </entry>
        <entry name="multiTickers" type="String">
            <label>Comma separated list of tickers</label>
            <default>AAPL, TSLA</default>
        </entry>
        <entry name="selectedTicker" type="String">
            <label>Last ticker selected in the multi-stock list</label>
            <default></default>
        </entry>
        <entry name="mouseRowLeftAction" type="String">
            <label>Left click on a watchlist row: select or open the Yahoo Finance quote</label>
            <default>select</default>
        </entry>
        <entry name="mouseMiddleAction" type="String">
            <label>Middle click action: refresh, open the Yahoo Finance quote, or none</label>
            <default>refresh</default>
        </entry>
        <entry name="mouseDoubleClickAction" type="String">
            <label>Double click action: open the Yahoo Finance quote or none</label>
            <default>open</default>
        </entry>
        <entry name="sortAlphabetically" type="Bool">
            <label>Sort Multi-Stock List Alphabetically</label>
            <default>false</default>
        </entry>
        <entry name="swapNameAndTicker" type="Bool">
            <label>Swap company name and ticker symbol</label>
            <default>false</default>
        </entry>
        <entry name="showNameAndTicker" type="Bool">
            <label>Show the company name together with the ticker symbol</label>
            <default>true</default>
        </entry>
        <entry name="refreshInterval" type="Int">
            <label>Refresh Interval (minutes)</label>
            <default>5</default>
        </entry>

        <entry name="chartRange" type="String">
            <label>Data History Range</label>
            <default>1D</default>
        </entry>
        <entry name="chartViewRange" type="String">
            <label>Range selected from the in-chart buttons (empty = use the data range)</label>
            <default></default>
        </entry>
        <entry name="showChartRangeButtons" type="Bool">
            <label>Show the data range buttons in the chart</label>
            <default>false</default>
        </entry>

        <!-- 0 = reference line split at the session open, 1 = candles + volume. -->
        <entry name="chartStyle" type="Int">
            <label>Chart style (0 = reference line, 1 = candles + volume)</label>
            <default>0</default>
        </entry>
        <entry name="showChartStyleButtons" type="Bool">
            <label>Show the chart style buttons (line/candles) in the chart</label>
            <default>false</default>
        </entry>

        <entry name="showChartHover" type="Bool">
            <label>Show values when hovering over the chart</label>
            <default>true</default>
        </entry>

        <entry name="limitHours" type="Bool">
            <label>Only update during specific hours</label>
            <default>false</default>
        </entry>
        <entry name="skipWeekendRefresh" type="Bool">
            <label>Do not refresh data on weekends</label>
            <default>true</default>
        </entry>
        <entry name="startHour" type="Int">
            <default>9</default>
        </entry>
        <entry name="startMinute" type="Int">
            <default>15</default>
        </entry>
        <entry name="endHour" type="Int">
            <default>15</default>
        </entry>
        <entry name="endMinute" type="Int">
            <default>30</default>
        </entry>
        <entry name="tickerColor" type="Color">
            <label>Ticker Text Color</label>
            <default>#FFFFFF</default>
        </entry>
        <entry name="tickerOpacity" type="Int">
            <label>Ticker Text Opacity</label>
            <default>100</default>
        </entry>
        <entry name="priceColor" type="Color">
            <label>Price Text Color</label>
            <default>#FFFFFF</default>
        </entry>
        <entry name="priceOpacity" type="Int">
            <label>Price Text Opacity</label>
            <default>100</default>
        </entry>
        <entry name="positiveColor" type="Color">
            <label>Positive Change Color</label>
            <default>#4cd964</default>
        </entry>
        <entry name="negativeColor" type="Color">
            <label>Negative Change Color</label>
            <default>#FF3B30</default>
        </entry>
        <entry name="bgOpacity" type="Int">
            <label>Background Opacity Base (Percent)</label>
            <default>100</default>
        </entry>
        <entry name="hideChangePercentage" type="Bool">
            <label>Hide Stock Change Percentage (Panel View)</label>
            <default>false</default>
        </entry>
        <entry name="autoCycle" type="Bool">
            <label>Automatically cycle the panel stock</label>
            <default>false</default>
        </entry>
        <entry name="autoCycleInterval" type="Int">
            <label>Seconds between panel stock changes</label>
            <default>15</default>
        </entry>
        <entry name="hideTimestamps" type="Bool">
            <label>Hide Update Timestamps</label>
            <default>true</default>
        </entry>
        <entry name="alternatePricePercent" type="Bool">
            <label>Alternate the price and the change percentage in the panel</label>
            <default>false</default>
        </entry>
        <entry name="alternateInterval" type="Int">
            <label>Seconds between switching price and percentage</label>
            <default>15</default>
        </entry>
        <entry name="fixedPanelWidth" type="Bool">
            <label>Keep the panel indicator at a fixed width</label>
            <default>true</default>
        </entry>
        <entry name="panelWidth" type="Int">
            <label>Fixed panel width in pixels (0 = fit the widest value)</label>
            <default>0</default>
            <min>0</min>
        </entry>
        <entry name="expandedViewBackground" type="Bool">
            <label>Draw the Plasma background behind the expanded widget</label>
            <default>true</default>
        </entry>
        <entry name="formatPrices" type="Bool">
            <label>Format stock price with commas</label>
            <default>true</default>
        </entry>
        <entry name="showExtendedHours" type="Bool">
            <label>Show pre-market and after-hours values</label>
            <default>true</default>
        </entry>
        <entry name="keepExtendedAfterClose" type="Bool">
            <label>Keep the last extended-hours quote when the market is closed</label>
            <default>true</default>
        </entry>
        <entry name="hideDecimals" type="Bool">
            <label>Hide decimals in stock price</label>
            <default>false</default>
        </entry>
        <entry name="showChartAxis" type="Bool">
            <label>Show a price scale on the right of the chart</label>
            <default>true</default>
        </entry>
        <entry name="showTimeAxis" type="Bool">
            <label>Show a time scale under the chart</label>
            <default>true</default>
        </entry>

        <!-- Portfolio Tracking -->
        <entry name="portfolioData" type="String">
            <label>Portfolio holdings data (JSON)</label>
            <default></default>
        </entry>
        <entry name="showPortfolioMode" type="Bool">
            <label>Show portfolio profit/loss in views</label>
            <default>false</default>
        </entry>
        <entry name="portfolioCurrency" type="String">
            <label>Portfolio currency used for totals</label>
            <default>USD</default>
        </entry>
        <!-- Daily exchange rates, cached by the widget so a restart does not need a download. -->
        <entry name="exchangeRates" type="String">
            <label>Cached daily exchange rates (JSON)</label>
            <default></default>
        </entry>
        <entry name="exchangeRatesUpdated" type="String">
            <label>Exchange rates last updated (Unix seconds)</label>
            <default></default>
        </entry>
        <entry name="exchangeRatesNext" type="String">
            <label>Exchange rates next update (Unix seconds)</label>
            <default></default>
        </entry>
    </group>
</kcfg>
